/dts-v1/;

/ {
    model = "RetroCoreTracer Z80 Studio Board";
    compatible = "sirosiro,rct-z80-board";

    #address-cells = <1>;
    #size-cells = <1>;

    chosen {
        stdout-path = "/vfpga_uart@40000000";
    };

    /* 標準 UART: CLI / テレメトリ通信用 */
    vfpga_uart@40000000 {
        compatible = "xlnx,xps-uartlite-1.00.a";
        reg = <0x40000000 0x1000>;
        label = "/dev/ttyUL0";
        port = <2000>;
    };

    /* Z80 Tracer Control Register (UIO) */
    vfpga_z80@42000000 {
        compatible = "generic-uio";
        reg = <0x42000000 0x1000>;
        label = "/dev/uio0";
        registers =
            "CTRL   @ 0x00",
            "STATUS @ 0x04",
            "CMD    @ 0x08",
            "CYCLES @ 0x0C";
    };
};
